+typedef struct {
+  UINT32    Size;
+  UINT32    Sets;
+  UINT8     Assoc;
+  UINT16    LineSize;
+} CACHE_GEOM;
+
+STATIC
+UINT32
+PpttGetValidCoreNum (
+  CM_CIX_CPU_TOPO_INFO  *CpuTopoInfo
+  )
+{
+  UINT32  ClusterIndex;
+  UINT32  Total = 0;
+
+  for (ClusterIndex = 0; ClusterIndex < CpuTopoInfo->ClusterNumber; ClusterIndex++) {
+    Total += GetClusterValidCoreNum (&CpuTopoInfo->ClusterTopo[ClusterIndex]);
+  }
+
+  return Total;
+}
+
+STATIC
+UINT32
+PpttGetValidClusterNum (
+  CM_CIX_CPU_TOPO_INFO  *CpuTopoInfo
+  )
+{
+  UINT32  ClusterIndex;
+  UINT32  Total = 0;
+
+  for (ClusterIndex = 0; ClusterIndex < CpuTopoInfo->ClusterNumber; ClusterIndex++) {
+    if (GetClusterValidCoreNum (&CpuTopoInfo->ClusterTopo[ClusterIndex]) > 0) {
+      Total++;
+    }
+  }
+
+  return Total;
+}
+
+/**
+  Read cache geometry from the CPU. Level is 0-based (L1=0, L2=1, L3=2).
+  All online cores are Cortex-A720, which implements FEAT_CCIDX, so CCSIDR_EL1
+  carries Associativity in bits [23:3] and NumberOfSets in bits [55:32].
+**/
+STATIC
+VOID
+PpttReadCacheGeom (
+  IN  UINT32       Level0Based,
+  IN  UINT32       InstrNotData,
+  OUT CACHE_GEOM  *Geom
+  )
+{
+  UINTN   Ccsidr;
+  UINT32  Assoc;
+  UINT32  Sets;
+
+  Ccsidr = ReadCCSIDR ((Level0Based << 1) | (InstrNotData & 1));
+  Geom->LineSize = (UINT16)(1 << ((Ccsidr & 0x7) + 4));
+  Assoc = (UINT32)((Ccsidr >> 3) & 0x1FFFFF) + 1;
+  Sets  = (UINT32)((Ccsidr >> 32) & 0xFFFFFF) + 1;
+  Geom->Assoc = (UINT8)((Assoc > 0xFF) ? 0xFF : Assoc);
+  Geom->Sets  = Sets;
+  Geom->Size  = (UINT32)Geom->LineSize * Assoc * Sets;
+}
+
+STATIC
+VOID
+PpttEmitCache (
+  IN OUT UINT8       **New,
+  IN     UINT32       NextLevel,
+  IN     CACHE_GEOM  *Geom,
+  IN     UINT8        CacheType
+  )
+{
+  EFI_ACPI_6_3_PPTT_STRUCTURE_CACHE  Cache;
+
+  ZeroMem (&Cache, sizeof (Cache));
+  Cache.Type   = EFI_ACPI_6_3_PPTT_TYPE_CACHE;
+  Cache.Length = sizeof (EFI_ACPI_6_3_PPTT_STRUCTURE_CACHE);
+  Cache.Flags.SizePropertyValid   = 1;
+  Cache.Flags.NumberOfSetsValid   = 1;
+  Cache.Flags.AssociativityValid  = 1;
+  Cache.Flags.AllocationTypeValid = 1;
+  Cache.Flags.CacheTypeValid      = 1;
+  Cache.Flags.WritePolicyValid    = 1;
+  Cache.Flags.LineSizeValid       = 1;
+  Cache.NextLevelOfCache          = NextLevel;
+  Cache.Size                      = Geom->Size;
+  Cache.NumberOfSets              = Geom->Sets;
+  Cache.Associativity             = Geom->Assoc;
+  Cache.Attributes.AllocationType = EFI_ACPI_6_3_CACHE_ATTRIBUTES_ALLOCATION_READ_WRITE;
+  Cache.Attributes.CacheType      = CacheType;
+  Cache.Attributes.WritePolicy    = EFI_ACPI_6_3_CACHE_ATTRIBUTES_WRITE_POLICY_WRITE_BACK;
+  Cache.LineSize                  = Geom->LineSize;
+  CopyMem (*New, &Cache, sizeof (EFI_ACPI_6_3_PPTT_STRUCTURE_CACHE));
+  *New += sizeof (EFI_ACPI_6_3_PPTT_STRUCTURE_CACHE);
+}
